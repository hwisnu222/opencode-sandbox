// Permission config for the OpenCode sandbox (JSONC: comments are allowed).
// Mounted read-only at ~/.config/opencode/opencode.jsonc inside the container.
// Rule order matters: the LAST matching rule wins. List general rules first, exceptions after.
{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    // Reading: allowed except credentials and key material.
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",
      "*.tfvars": "deny",
      "*/terraform.tfstate*": "deny",
      "*/id_rsa*": "deny",
      "*/id_ed25519*": "deny",
      "*/.ssh/*": "deny",
      ".ssh/*": "deny",
      "*/.aws/*": "deny",
      ".aws/*": "deny",
      "*/.kube/*": "deny",
      ".kube/*": "deny",
      "*/.gnupg/*": "deny",
      ".gnupg/*": "deny",
      "*/.docker/config.json": "deny",
      "*/.pgpass": "deny",
      "*/.config/gh/*": "deny",
      "*/.config/gcloud/*": "deny",
      "*/.config/opencode/auth.json": "deny",
      "*/.local/share/opencode/auth.json": "deny",
      "*/.netrc": "deny",
      "*/.npmrc": "deny",
      "*/.git-credentials": "deny",
      "/etc/shadow": "deny",
      "/etc/sudoers*": "deny"
    },
    // Editing: same idea, plus git hooks and shell dotfiles (they can run code indirectly).
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*/.ssh/*": "deny",
      ".ssh/*": "deny",
      "*/.aws/*": "deny",
      "*/.kube/*": "deny",
      "*/.gnupg/*": "deny",
      "*/.netrc": "deny",
      "*/.npmrc": "deny",
      "*/.git-credentials": "deny",
      "*/.gitconfig": "deny",
      "*/.git/hooks/*": "deny",
      ".git/hooks/*": "deny",
      "*/.config/opencode/*": "deny",
      "*/.bashrc": "deny",
      "*/.bash_profile": "deny",
      "*/.zshrc": "deny",
      "*/.zshenv": "deny",
      "*/.zprofile": "deny",
      "*/.profile": "deny",
      "*/.config/fish/*": "deny",
      "/etc/*": "deny"
    },
    // Commands: ask by default; read-only and test/lint/build commands allowed; dangerous ones denied.
    "bash": {
      "*": "ask",

      // Read-only navigation and search
      "ls*": "allow",
      "pwd": "allow",
      "tree*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find * -name*": "allow",
      "which *": "allow",
      "file *": "allow",
      "diff *": "allow",

      // Git: read-only commands, plus local add/commit (push stays on ask)
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "git branch --list*": "allow",
      "git blame*": "allow",
      "git ls-files*": "allow",
      "git add*": "allow",
      "git commit*": "allow",

      // Test, lint and build runners. Adjust for your stack; avoid broad wildcards such as npm run *
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run build*": "allow",
      "npm run typecheck*": "allow",
      "npx tsc*": "allow",
      "npx eslint*": "allow",
      "npx prettier*": "allow",
      "pnpm test*": "allow",
      "pnpm lint*": "allow",
      "pytest*": "allow",
      "ruff *": "allow",
      "go test*": "allow",
      "go vet*": "allow",
      "cargo test*": "allow",
      "cargo check*": "allow",
      "cargo clippy*": "allow",

      // Side effects or network access: always ask
      "curl *": "ask",
      "wget *": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git push*": "ask",
      "docker *": "ask",
      "kubectl *": "ask",
      "aws *": "ask",
      "bash -c *": "ask",
      "sh -c *": "ask",
      "python* -c *": "ask",
      "node -e *": "ask",
      "find * -exec*": "ask",

      // Deny rules come LAST so they override the allow rules above
      "*.env*": "deny",
      "*.pem*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*/.ssh/*": "deny",
      "*.ssh/*": "deny",
      "*/.aws/*": "deny",
      "*/.kube/*": "deny",
      "*/.gnupg/*": "deny",
      "*/.netrc*": "deny",
      "*/.npmrc*": "deny",
      "*/.git-credentials*": "deny",
      "env": "deny",
      "printenv*": "deny",
      "export -p": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "chmod 777*": "deny",
      "rm -*": "deny",
      "find * -delete*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "eval *": "deny",
      "nmap *": "deny",
      "nc *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "npm publish*": "deny",
      "curl *|*": "deny",
      "wget *|*": "deny",
      "*| sh*": "deny",
      "*| bash*": "deny"
    },
    // Never touch paths outside the project
    "external_directory": "deny",
    "webfetch": "allow",
    // Only these skills may be loaded
    "skill": {
      "*": "deny",
      "security-guard": "allow",
      "code-slop-filter": "allow",
      "copywriting-originality": "allow",
      "ui-slop-filter": "allow"
    }
  }
}
